-- ===== Line number updater =====
local function updateLineNumbers()
    local text = InputBox.Text
    local count = 1
    for _ in string.gmatch(text, "\n") do
        count = count + 1
    end
    local out = {}
    for i = 1, count do
        out[i] = tostring(i)
    end
    LineNumbers.Text = table.concat(out, "\n")
end

InputBox:GetPropertyChangedSignal("Text"):Connect(updateLineNumbers)
updateLineNumbers()

-- ===== Icon dragging =====
local iconDragging = false
local iconDragStart
local iconStartPos

Icon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        iconDragging = true
        iconDragStart = input.Position
        iconStartPos = IconHolder.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if iconDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - iconDragStart
        IconHolder.Position = UDim2.new(
            iconStartPos.X.Scale,
            iconStartPos.X.Offset + delta.X,
            iconStartPos.Y.Scale,
            iconStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        iconDragging = false
    end
end)

-- ===== Click icon to toggle panel =====
local iconPressPos
Icon.MouseButton1Down:Connect(function()
    iconPressPos = UserInputService:GetMouseLocation()
end)

Icon.MouseButton1Click:Connect(function()
    local now = UserInputService:GetMouseLocation()
    local shouldToggle = true
    if iconPressPos then
        local dx = math.abs(now.X - iconPressPos.X)
        local dy = math.abs(now.Y - iconPressPos.Y)
        if dx >= 6 or dy >= 6 then
            shouldToggle = false
        end
    end
    if shouldToggle then
        Panel.Visible = not Panel.Visible
        if Panel.Visible then
            Panel.BackgroundTransparency = 1
            Panel.Size = UDim2.new(0, 360, 0, 240)
            TweenService:Create(Panel, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 360, 0, 240),
                BackgroundTransparency = 0,
            }):Play()
        end
    end
end)

